provides=('spanbox')
conflicts=('spanbox')
options=('!strip' '!debug')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/Ray0907/spanbox/v$pkgver/LICENSE")
source_x86_64=("spanbox-$pkgver-x86_64::$url/releases/download/v$pkgver/spanbox_v${pkgver}_linux_amd64")
source_aarch64=("spanbox-$pkgver-aarch64::$url/releases/download/v$pkgver/spanbox_v${pkgver}_linux_arm64")
sha256sums=('69ad1690db1c7dbd6da929e4209f2c7a3968816e0dff03426117b75d83fc9f5c')
